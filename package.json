{
  "name": "einsager",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "description": "Desktop dictation using your local Codex login",
  "license": "MIT",
  "main": "apps/desktop/dist/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "build": "cargo build --locked --release -j 1 && node apps/desktop/scripts/build.mjs",
    "build:ui": "node apps/desktop/scripts/build.mjs",
    "start": "node apps/desktop/scripts/start.mjs",
    "check": "tsc --noEmit && node --test apps/desktop/tests/*.test.ts apps/desktop/tests/*.test.mjs",
    "package": "node apps/desktop/scripts/package.mjs",
    "install:macos": "node apps/desktop/scripts/install-macos.mjs",
    "preview": "vite --host 0.0.0.0 --config apps/desktop/vite.config.ts",
    "test:desktop": "node apps/desktop/tests/smoke.mjs",
    "test:packaged": "node apps/desktop/tests/smoke.mjs --packaged",
    "test:linux": "node apps/desktop/tests/linux-desktop.mjs && node apps/desktop/tests/smoke.mjs --wayland-policy",
    "test:native": "node apps/desktop/tests/native-macos.mjs",
    "test:macos": "mkdir -p target/tests && swiftc -j 1 apps/desktop/native/macos/KeyboardShortcuts.swift apps/desktop/native/macos/tests/ShortcutTests.swift -o target/tests/shortcut-tests -framework AppKit && target/tests/shortcut-tests"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
